# ダミー値のみ。本物の値はコミットしない（Fly secrets / ローカルの .env に置く）。
# この内容は packages/config のテストで検証される（ここが古くなるとテストが落ちる）。

# local / test / staging / production
APP_ENV=local
PORT=8080
LOG_LEVEL=info

# local / test では mock 以外を指定すると起動しない（ADR-0004 / ADR-0007）
TELEPHONY_PROVIDER=mock

# staging / production では必須
DATABASE_URL=postgres://tac:tac@localhost:5432/tac
SESSION_SECRET=replace-with-at-least-32-random-characters

# 安全装置（既定 ON。production では false にできない）
VERIFY_WEBHOOK_SIGNATURES=true
ENFORCE_CALLING_WINDOW=true

# TELEPHONY_PROVIDER=twilio のときだけ必要（形式だけ正しいダミー値）
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-me-with-the-real-token
