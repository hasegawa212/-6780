# ダミー値のみ。本物の値はコミットしない（Fly secrets / ローカルの .env に置く）。
# この内容は packages/config のテストで検証される（ここが古くなるとテストが落ちる）。

# local / test / staging / production
APP_ENV=local
PORT=8080
LOG_LEVEL=info

# local / test では mock 以外を指定すると起動しない（ADR-0004 / ADR-0007）
TELEPHONY_PROVIDER=mock

# mock（電話シミュレーター）の Webhook の署名鍵（32 文字以上）。未設定なら mock の Webhook はすべて拒否する。
# mock の Webhook の受け口は local / test でだけ開く
MOCK_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# local / test のデモ用シード（担当者 operator@example.test のパスワード、12 文字以上）。staging / production では指定すると起動しない
# DEV_SEED_PASSWORD=replace-with-a-local-password

# 要求元の IP を取るヘッダー（プロキシが必ず上書きするものだけ。例：Fly.io なら fly-client-ip）。未設定なら接続元のアドレス
# TRUSTED_CLIENT_IP_HEADER=fly-client-ip

# staging / production では必須
DATABASE_URL=postgres://tac:tac@localhost:5432/tac
SESSION_SECRET=replace-with-at-least-32-random-characters

# 安全装置（既定 ON。production では false にできない）
VERIFY_WEBHOOK_SIGNATURES=true
ENFORCE_CALLING_WINDOW=true

# 危険な機能のゲート（すべて既定 OFF。APP_ENV=production だけでは発信は始まらない）
# OUTBOUND_CALLS_ENABLED=false のあいだは、発信判定が OUTBOUND_DISABLED_BY_CONFIG で全発信を止める（evaluateCallPolicy）
# AUTO_DIAL / AI_VOICE は OUTBOUND_CALLS_ENABLED=true のときだけ有効にできる
OUTBOUND_CALLS_ENABLED=false
AUTO_DIAL_ENABLED=false
AI_VOICE_ENABLED=false
RECORDING_ENABLED=false

# TELEPHONY_PROVIDER=twilio のときだけ必要（形式だけ正しいダミー値）
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-me-with-the-real-token
# Twilio（staging / production で TELEPHONY_PROVIDER=twilio のときだけ必須。ADR-0015）
# 担当者の電話番号（E.164）。発信はまずここへ、次にお客様へ（同じ会議につなぐ）
# TWILIO_AGENT_NUMBER=+81300000001
# Twilio から状態通知が届く公開 URL のオリジン（https、末尾のパスなし）。署名の検証にも使う
# PUBLIC_BASE_URL=https://tac-next.example.test
# 呼び出しを待つ秒数（5〜600、既定 30）と、1 通話の最長秒数（60〜14400、既定 1800）
# TWILIO_RING_TIMEOUT_SECONDS=30
# TWILIO_CALL_TIME_LIMIT_SECONDS=1800
